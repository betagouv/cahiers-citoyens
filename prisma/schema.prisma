generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Cahier {
  id               String   @id
  codeInsee        String   @map("code_insee")
  commune          String
  departement      String
  region           String
  dateOuverture    DateTime @map("date_ouverture") @db.Date
  cleScan          String   @map("cle_scan")
  cleTranscription String   @map("cle_transcription")
  transcription    String
  importeLe        DateTime @default(now()) @map("importe_le") @db.Timestamptz
  chunks           Chunk[]

  @@index([departement])
  @@index([codeInsee])
  @@map("cahiers")
}

model Chunk {
  id        BigInt                       @id @default(autoincrement())
  cahier    Cahier                       @relation(fields: [cahierId], references: [id], onDelete: Cascade)
  cahierId  String                       @map("cahier_id")
  ordre     Int
  contenu   String
  // Colonne générée (GENERATED ALWAYS AS ... STORED), écrite à la main dans la migration init.
  // dbgenerated reprend son expression pour que Prisma n'y voie pas de dérive.
  recherche Unsupported("tsvector")?     @default(dbgenerated("to_tsvector('french'::regconfig, contenu)"))
  // 1024 : dimension supposée de bge-m3, le modèle d'embeddings visé chez Albert. À confirmer.
  embedding Unsupported("vector(1024)")?

  @@unique([cahierId, ordre])
  @@index([recherche], type: Gin)
  // hnsw (vector_cosine_ops), créé à la main dans la migration init : Prisma ne connaît pas
  // ce type d'index. Le déclarer ici empêche migrate dev de le supprimer.
  @@index([embedding], map: "chunks_embedding_idx")
  @@map("chunks")
}
