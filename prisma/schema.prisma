generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Notebook {
  id               String   @id
  inseeCode        String   @map("insee_code")
  municipality     String
  department       String
  region           String
  openedOn         DateTime @map("opened_on") @db.Date
  scanKey          String   @map("scan_key")
  transcriptionKey String   @map("transcription_key")
  transcription    String
  importedAt       DateTime @default(now()) @map("imported_at") @db.Timestamptz
  chunks           Chunk[]

  @@index([department])
  @@index([inseeCode])
  @@map("notebooks")
}

model Chunk {
  id         BigInt                       @id @default(autoincrement())
  notebook   Notebook                     @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  notebookId String                       @map("notebook_id")
  position   Int
  content    String
  // Colonne générée (GENERATED ALWAYS AS ... STORED), écrite à la main dans la migration init.
  // dbgenerated reprend son expression pour que Prisma n'y voie pas de dérive.
  search     Unsupported("tsvector")?     @default(dbgenerated("to_tsvector('french'::regconfig, content)"))
  // 1024 : dimension supposée de bge-m3, le modèle d'embeddings visé chez Albert. À confirmer.
  embedding  Unsupported("vector(1024)")?

  @@unique([notebookId, position])
  @@index([search], type: Gin)
  // hnsw (vector_cosine_ops), créé à la main dans la migration init : Prisma ne connaît pas
  // ce type d'index. Le déclarer ici empêche migrate dev de le supprimer.
  @@index([embedding], map: "chunks_embedding_idx")
  @@map("chunks")
}
